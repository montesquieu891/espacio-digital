---
// Tarjeta de una publicación. Mismo estilo que las tarjetas de proyectos de la portada.
import { formatearFecha, NOMBRE_CATEGORIA, type Publicacion } from "../core/publicaciones";

interface Props {
	publicacion: Publicacion;
}

const { publicacion } = Astro.props;
const { titulo, fecha, categoria, resumen, link, borrador } = publicacion.data;
---

<a
	href={`/publicaciones/${publicacion.id}`}
	class="group border border-neutral-800 p-8 hover:bg-neutral-900 transition-all duration-300 relative overflow-hidden block"
>
	<div
		class="absolute top-0 left-0 w-1 h-full bg-neutral-800 group-hover:bg-white transition-colors duration-300"
	>
	</div>
	<div class="flex justify-between items-start gap-4">
		<span class="text-xs font-mono text-neutral-500 mb-4 block uppercase">
			{NOMBRE_CATEGORIA[categoria]}
			{borrador && <span class="ml-2 text-amber-400">· Borrador</span>}
		</span>
		<span
			class="text-xs text-neutral-600 group-hover:text-white transition-colors whitespace-nowrap"
		>
			{link && <span title="Comparte un enlace externo">↗ </span>}
			<time datetime={fecha.toISOString().slice(0, 10)}>{formatearFecha(fecha)}</time>
		</span>
	</div>
	<h3 class="text-2xl font-bold mb-2 group-hover:text-white">{titulo}</h3>
	<p class="text-sm text-neutral-400 leading-relaxed">{resumen}</p>
</a>
