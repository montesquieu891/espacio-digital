---
import Layout from "../core/Layout.astro";
import TarjetaPublicacion from "../components/TarjetaPublicacion.astro";
import { getPublicaciones } from "../core/publicaciones";

// Las 6 publicaciones más recientes; el resto queda en /publicaciones
const ULTIMAS = 6;
const publicaciones = await getPublicaciones();
const ultimas = publicaciones.slice(0, ULTIMAS);
---

<Layout title="Juan Andres Fernandez | Espacio Digital">
	<!-- Fuente del título de la tarjeta SGD MOMENTUM (la misma que usa /optimization) -->
	<link
		href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap"
		rel="stylesheet"
	/>
	<main class="flex flex-col min-h-screen bg-[#0a0a0a] text-[#e5e5e5]">
		<section
			class="flex-grow flex flex-col items-center justify-center p-4 text-center min-h-[50vh]"
		>
			<p
				class="text-xs font-mono text-neutral-500 mb-4 tracking-[0.3em] uppercase"
			>
				By Juan Andres Fernandez
			</p>

			<h1
				class="text-4xl md:text-7xl font-bold tracking-tighter leading-tight mb-6"
			>
				DATA <span class="text-neutral-700">|</span> FINANCE <span
					class="text-neutral-700">|</span
				> CODE
			</h1>

			<p class="text-neutral-400 text-lg md:text-xl max-w-2xl font-light">
				Explorando la intersección entre sistemas complejos, modelado
				cuantitativo y desarrollo de software.
			</p>
		</section>

		<section class="w-full max-w-7xl mx-auto px-4 py-12 pb-24">
			<div
				class="flex items-baseline justify-between mb-8 border-b border-neutral-800 pb-2"
			>
				<h2
					class="text-sm font-bold uppercase tracking-widest text-neutral-300"
				>
					Índice de Proyectos
				</h2>
				<span class="text-xs text-neutral-500 font-mono">2026</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<a
					href="/finance"
					class="group border border-neutral-800 p-8 hover:bg-neutral-900 transition-all duration-300 cursor-pointer relative overflow-hidden block"
				>
					<div
						class="absolute top-0 left-0 w-1 h-full bg-neutral-800 group-hover:bg-white transition-colors duration-300"
					>
					</div>
					<div class="flex justify-between items-start">
						<span
							class="text-xs font-mono text-neutral-500 mb-4 block"
							>PYTHON / QUANT ANALYSIS</span
						>
						<span
							class="text-xs text-neutral-600 group-hover:text-white transition-colors"
							>↗ ACTIVE</span
						>
					</div>
					<h3 class="text-2xl font-bold mb-2 group-hover:text-white">
						Simulación de Mercados
					</h3>
					<p class="text-sm text-neutral-400 leading-relaxed">
						Pipeline de datos en tiempo real. Análisis de activos
						financieros (SPY, MELI, BTC) procesados con Pandas.
					</p>
				</a>

				<a
					href="/biologia"
					class="group border border-neutral-800 p-8 hover:bg-neutral-900 transition-all duration-300 relative overflow-hidden block"
				>
					<div
						class="absolute top-0 left-0 w-1 h-full bg-neutral-800 group-hover:bg-white transition-colors duration-300"
					>
					</div>
					<div class="flex justify-between items-start">
						<span
							class="text-xs font-mono text-neutral-500 mb-4 block"
							>COMPUTATIONAL BIOLOGY</span
						>
						<span
							class="text-xs text-neutral-600 group-hover:text-white transition-colors"
							>↗ INTERACTIVE</span
						>
					</div>
					<h3 class="text-2xl font-bold mb-2 group-hover:text-white">
						Sistemas Emergentes
					</h3>
					<p class="text-sm text-neutral-400 leading-relaxed">
						Simulación interactiva de patrones complejos a través de
						Autómatas Celulares (Game of Life).
					</p>
				</a>
				<a
					href="/optimization"
					class="group relative block bg-[#0a0e14] border border-gray-800 hover:border-[#00e5ff] transition-all duration-300 overflow-hidden"
				>
					<div
						class="absolute inset-0 bg-[#00e5ff]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
					>
					</div>

					<div class="p-6 h-full flex flex-col relative z-10">
						<div class="flex justify-between items-start mb-4">
							<span
								class="text-[10px] font-mono text-[#00e5ff] tracking-widest uppercase border border-[#00e5ff]/30 px-2 py-1 rounded"
							>
								MATH_ENGINE
							</span>
							<span
								class="text-xs text-gray-500 group-hover:text-[#00e5ff] transition-colors"
								>↗ V.3.1</span
							>
						</div>

						<h3
							class="text-xl font-bold text-white mb-2 font-['Orbitron'] group-hover:text-[#00e5ff] transition-colors"
						>
							SGD MOMENTUM
						</h3>
						<p
							class="text-sm text-gray-400 leading-relaxed font-mono"
						>
							Explorador interactivo de superficies no convexas.
							Simulación de física de gradientes en tiempo real.
						</p>

						<div
							class="mt-auto pt-6 flex gap-3 text-[10px] font-mono text-gray-600"
						>
							<span class="flex items-center gap-1">
								<div
									class="w-1.5 h-1.5 bg-pink-500 rounded-full"
								>
								</div> R&D
							</span>
							<span>•</span>
							<span>WEBGL</span>
							<span>•</span>
							<span>PYTHON</span>
						</div>
					</div>
				</a>
			</div>

			{
				ultimas.length > 0 && (
					<>
						<div class="flex items-baseline justify-between mt-16 mb-8 border-b border-neutral-800 pb-2">
							<h2 class="text-sm font-bold uppercase tracking-widest text-neutral-300">
								Últimas publicaciones
							</h2>
							<a
								href="/publicaciones"
								class="text-xs text-neutral-500 hover:text-white font-mono transition-colors"
							>
								Ver todas ({publicaciones.length}) →
							</a>
						</div>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{ultimas.map((p) => (
								<TarjetaPublicacion publicacion={p} />
							))}
						</div>
					</>
				)
			}

			<footer
				class="w-full py-8 text-center text-xs text-neutral-700 border-t border-neutral-900 mt-12 font-mono"
			>
				<p>
					JUAN ANDRES FERNANDEZ &copy; {new Date().getFullYear()}
				</p>
			</footer>
		</section>
	</main>
</Layout>
