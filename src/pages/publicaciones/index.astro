---
// Archivo: todas las publicaciones, de la más nueva a la más vieja, agrupadas por año.
import Layout from "../../core/Layout.astro";
import TarjetaPublicacion from "../../components/TarjetaPublicacion.astro";
import { getPublicaciones } from "../../core/publicaciones";

const publicaciones = await getPublicaciones();

const porAnio = new Map<number, typeof publicaciones>();
for (const p of publicaciones) {
	const anio = p.data.fecha.getUTCFullYear();
	porAnio.set(anio, [...(porAnio.get(anio) ?? []), p]);
}
---

<Layout title="Publicaciones | Espacio Digital">
	<main class="min-h-screen bg-[#0a0a0a] text-[#e5e5e5] p-8 flex flex-col items-center">
		<div class="w-full max-w-7xl">
			<header class="mb-8 border-b border-neutral-800 pb-4 flex justify-between items-end">
				<div>
					<a
						href="/"
						class="text-xs text-neutral-500 hover:text-white mb-2 block uppercase tracking-widest"
					>
						← Volver al inicio
					</a>
					<h1 class="text-4xl font-bold text-white">Publicaciones</h1>
				</div>
				<div class="text-right">
					<span class="text-xs font-mono text-neutral-600 block">TOTAL</span>
					<span class="text-xl font-bold">{publicaciones.length}</span>
				</div>
			</header>

			{
				publicaciones.length === 0 && (
					<p class="text-neutral-500 font-mono text-sm">Todavía no hay publicaciones.</p>
				)
			}

			{
				[...porAnio].map(([anio, lista]) => (
					<section class="mb-12">
						<h2 class="text-sm font-bold uppercase tracking-widest text-neutral-300 mb-6 font-mono">
							{anio}
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							{lista.map((p) => (
								<TarjetaPublicacion publicacion={p} />
							))}
						</div>
					</section>
				))
			}
		</div>
	</main>
</Layout>
