---
import Layout from "../core/Layout.astro";
---

<Layout title="SGD Momentum | Research Terminal">
    <script is:inline src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap"
        rel="stylesheet"
    />

    <style>
        :root {
            --bg-navy: #0a0e14;
            --cyan: #00e5ff;
            --magenta: #ff006e;
            --green: #06ffa5;
        }
        body {
            background-color: var(--bg-navy);
            font-family: "JetBrains Mono", monospace;
        }
        h1,
        h2,
        label {
            font-family: "Orbitron", sans-serif;
        }

        /* Grid de fondo */
        .cyber-grid {
            background-image:
                linear-gradient(rgba(0, 229, 255, 0.03) 1px, transparent 1px),
                linear-gradient(
                    90deg,
                    rgba(0, 229, 255, 0.03) 1px,
                    transparent 1px
                );
            background-size: 40px 40px;
        }

        /* CORRECCIÓN: Usamos CSS estándar en lugar de @apply para evitar conflictos */
        input[type="range"] {
            width: 100%;
            height: 4px; /* Equivalente a h-1 */
            background-color: #1f2937; /* Equivalente a bg-gray-800 */
            border-radius: 0.5rem;
            appearance: none;
            cursor: pointer;
        }

        /* Thumb (La bolita del slider) */
        input[type="range"]::-webkit-slider-thumb {
            height: 16px; /* w-4 */
            width: 16px; /* h-4 */
            border-radius: 2px; /* rounded-sm */
            background-color: #22d3ee; /* cyan-400 */
            appearance: none;
            box-shadow: 0 0 10px #00e5ff;
            margin-top: -6px; /* Centrado vertical */
        }

        /* Compatibilidad Firefox */
        input[type="range"]::-moz-range-thumb {
            height: 16px;
            width: 16px;
            border-radius: 2px;
            background-color: #22d3ee;
            border: none;
            box-shadow: 0 0 10px #00e5ff;
        }
    </style>

    <main
        class="flex flex-col h-screen text-gray-300 cyber-grid overflow-hidden"
    >
        <header
            class="flex justify-between items-center px-6 py-4 border-b border-gray-800 bg-[#0a0e14]/90 backdrop-blur z-20"
        >
            <div class="flex items-center gap-3">
                <div
                    class="w-3 h-3 bg-pink-500 rounded-full animate-pulse shadow-[0_0_15px_#ff006e]"
                >
                </div>
                <div>
                    <h1
                        class="text-xl font-bold tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-pink-500"
                    >
                        SGD VISUALIZER
                    </h1>
                    <p class="text-[10px] text-cyan-500/70 tracking-[0.3em]">
                        CLAUDE ENGINE // MOMENTUM OPTIMIZER
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <button
                    id="infoBtn"
                    class="flex items-center gap-2 px-3 py-1 border border-cyan-500/30 rounded hover:bg-cyan-500/10 transition-all group"
                >
                    <span
                        class="text-cyan-400 font-mono text-xs group-hover:text-white"
                        >ERROR_LOG_ANALYSIS</span
                    >
                    <span
                        class="flex items-center justify-center w-4 h-4 rounded-full border border-cyan-400 text-[10px] text-cyan-400"
                        >?</span
                    >
                </button>

                <div
                    class="hidden sm:block text-right text-xs font-mono text-gray-500 border-l border-gray-800 pl-4"
                >
                    <span class="text-green-400">SYSTEM: ONLINE</span>
                </div>
            </div>
        </header>

        <div class="flex flex-grow overflow-hidden relative z-10">
            <aside
                class="w-80 border-r border-gray-800 bg-[#0a0e14]/95 p-6 flex flex-col gap-8 overflow-y-auto"
            >
                <div class="space-y-2">
                    <label
                        class="text-xs text-pink-500 font-bold tracking-widest uppercase"
                        >Loss Surface</label
                    >
                    <div class="relative">
                        <select
                            id="funcSelector"
                            class="w-full bg-[#111] border border-cyan-500/30 text-cyan-400 p-3 text-xs outline-none focus:border-cyan-400 uppercase cursor-pointer appearance-none"
                        >
                            <option value="rastrigin"
                                >Rastrigin (Non-Convex)</option
                            >
                            <option value="himmelblau"
                                >Himmelblau (4 Minima)</option
                            >
                            <option value="ackley">Ackley (The Trap)</option>
                            <option value="rosenbrock"
                                >Rosenbrock (Valley)</option
                            >
                        </select>
                    </div>
                </div>

                <div class="space-y-6 border-t border-gray-800 pt-6">
                    <h3 class="text-xs text-gray-500 font-bold uppercase mb-2">
                        Hyperparameters
                    </h3>

                    <div class="space-y-2">
                        <div class="flex justify-between text-xs font-mono">
                            <span class="text-cyan-400">LEARNING RATE (α)</span>
                            <span
                                id="lrVal"
                                class="text-white bg-cyan-500/20 px-2 rounded"
                                >0.020</span
                            >
                        </div>
                        <input
                            type="range"
                            id="lr"
                            min="0.001"
                            max="0.15"
                            step="0.001"
                            value="0.02"
                        />
                    </div>

                    <div class="space-y-2">
                        <div class="flex justify-between text-xs font-mono">
                            <span class="text-pink-500">MOMENTUM (γ)</span>
                            <span
                                id="momVal"
                                class="text-white bg-pink-500/20 px-2 rounded"
                                >0.85</span
                            >
                        </div>
                        <input
                            type="range"
                            id="mom"
                            min="0"
                            max="0.99"
                            step="0.01"
                            value="0.85"
                        />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-2">
                    <button
                        id="randomize"
                        class="border border-cyan-500 text-cyan-400 py-3 text-xs hover:bg-cyan-500/10 font-bold uppercase tracking-wider transition-all"
                    >
                        🎲 Random Init
                    </button>
                    <button
                        id="runBtn"
                        class="bg-pink-600 text-white py-3 text-xs hover:bg-pink-500 font-bold uppercase tracking-wider shadow-lg shadow-pink-500/40 transition-all"
                    >
                        ▶ Run Sim
                    </button>
                </div>

                <div
                    class="mt-auto bg-[#050505] border border-gray-800 p-4 rounded text-xs font-mono space-y-2"
                >
                    <div class="flex justify-between">
                        <span class="text-gray-600">POS:</span>
                        <span id="posVal" class="text-cyan-400">0.00, 0.00</span
                        >
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">LOSS:</span>
                        <span id="lossVal" class="text-pink-500 font-bold"
                            >--</span
                        >
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">VELOCITY:</span>
                        <span id="velVal" class="text-green-400">0.00</span>
                    </div>
                </div>
            </aside>

            <section class="flex-grow relative bg-black">
                <div id="plot" class="w-full h-full"></div>
                <div
                    id="loading"
                    class="absolute inset-0 flex flex-col items-center justify-center bg-black/90 z-50"
                >
                    <div
                        class="w-12 h-12 border-2 border-cyan-500 border-t-transparent rounded-full animate-spin mb-4"
                    >
                    </div>
                    <span class="text-cyan-500 font-mono text-xs animate-pulse"
                        >LOADING CLAUDE DATA...</span
                    >
                </div>
            </section>
        </div>
        <div
            id="infoModal"
            class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4"
        >
            <div
                class="bg-[#0a0e14] border border-cyan-500/30 w-full max-w-3xl max-h-[85vh] overflow-y-auto shadow-[0_0_50px_rgba(0,229,255,0.1)] relative"
            >
                <div
                    class="sticky top-0 bg-[#0a0e14]/95 border-b border-gray-800 p-6 flex justify-between items-center backdrop-blur"
                >
                    <h2
                        class="text-xl text-white font-bold tracking-widest flex items-center gap-2"
                    >
                        <span class="text-magenta-500">///</span> THEORETICAL BRIEFING
                    </h2>
                    <button
                        id="closeModal"
                        class="text-gray-500 hover:text-white font-mono text-xl"
                    >
                        [X] CLOSE
                    </button>
                </div>

                <div
                    class="p-8 space-y-8 text-gray-300 font-mono text-sm leading-relaxed"
                >
                    <section>
                        <h3
                            class="text-cyan-400 font-bold mb-3 flex items-center gap-2"
                        >
                            <span class="text-xs border border-cyan-400 px-1"
                                >01</span
                            > THE BLIND HIKER PROBLEM
                        </h3>
                        <p class="mb-4">
                            Imagina que estás en una cordillera oscura y densa
                            (la <span class="text-white"
                                >Superficie de Pérdida</span
                            >). Tu objetivo es encontrar el punto más bajo del
                            valle (el <span class="text-green-400"
                                >Mínimo Global</span
                            >), donde el error de tu modelo es 0.
                        </p>
                        <p>
                            El problema es que estás ciego. Solo puedes sentir
                            la inclinación del suelo bajo tus pies con cada
                            paso.
                        </p>
                        <div
                            class="bg-black/50 p-4 border-l-2 border-cyan-500 my-4 text-xs font-mono"
                        >
                            <p>> High Elevation = High Error (Bad Model)</p>
                            <p>
                                > Lowest Point = Optimal Solution (Smart Model)
                            </p>
                        </div>
                    </section>

                    <section class="grid md:grid-cols-2 gap-8">
                        <div>
                            <h3
                                class="text-magenta-500 font-bold mb-3 flex items-center gap-2"
                            >
                                <span
                                    class="text-xs border border-magenta-500 px-1"
                                    >02</span
                                > GRADIENT DESCENT (SGD)
                            </h3>
                            <p class="mb-2">
                                El algoritmo básico calcula la pendiente
                                (gradiente) y da un paso hacia abajo.
                            </p>
                            <ul
                                class="list-disc list-inside text-gray-400 space-y-1 mb-4"
                            >
                                <li>
                                    <span class="text-white"
                                        >Learning Rate (α):</span
                                    > El tamaño de tu paso.
                                </li>
                                <li>
                                    Si es muy pequeño: Tardas una eternidad.
                                </li>
                                <li>
                                    Si es muy grande: Saltas sobre el valle y te
                                    pierdes (Divergencia).
                                </li>
                            </ul>
                        </div>

                        <div>
                            <h3
                                class="text-green-400 font-bold mb-3 flex items-center gap-2"
                            >
                                <span
                                    class="text-xs border border-green-400 px-1"
                                    >03</span
                                > WHY MOMENTUM?
                            </h3>
                            <p class="mb-2">
                                SGD clásico se atasca en pequeños agujeros (<span
                                    class="text-white">Mínimos Locales</span
                                >).
                            </p>
                            <p>
                                El <strong>Momentum</strong> añade física: convierte
                                tu punto en una "bola pesada". Si viene bajando rápido,
                                la inercia le permite subir pequeñas colinas y salir
                                de las trampas locales para seguir buscando el fondo
                                real.
                            </p>
                        </div>
                    </section>

                    <section
                        class="border border-gray-800 bg-black p-6 rounded relative overflow-hidden group"
                    >
                        <div
                            class="absolute top-0 right-0 p-2 text-[10px] text-gray-600"
                        >
                            MATH_KERNEL.PY
                        </div>
                        <h3 class="text-white font-bold mb-4">
                            THE UPDATE RULE
                        </h3>

                        <div
                            class="flex flex-col gap-4 font-mono text-xs sm:text-sm"
                        >
                            <div class="flex items-center gap-4">
                                <span class="text-magenta-500 font-bold"
                                    >Velocity:</span
                                >
                                <code class="text-gray-400"
                                    >v<sub class="text-gray-600">t</sub> = <span
                                        class="text-green-400">γ</span
                                    >·v<sub class="text-gray-600">t-1</sub> + <span
                                        class="text-cyan-400">α</span
                                    >·∇f(θ)</code
                                >
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="text-cyan-400 font-bold"
                                    >Position:</span
                                >
                                <code class="text-gray-400"
                                    >θ<sub class="text-gray-600">t+1</sub> = θ<sub
                                        class="text-gray-600">t</sub
                                    > - v<sub class="text-gray-600">t</sub
                                    ></code
                                >
                            </div>
                        </div>

                        <p class="mt-4 text-xs text-gray-500">
                            Donde <span class="text-green-400">γ (Gamma)</span> es
                            el factor de inercia y <span class="text-cyan-400"
                                >α (Alpha)</span
                            > es la tasa de aprendizaje.
                        </p>
                    </section>
                </div>

                <div
                    class="p-6 border-t border-gray-800 bg-[#0a0e14] flex justify-end"
                >
                    <button
                        id="acknowledgeBtn"
                        class="bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/50 px-6 py-2 text-xs font-bold tracking-widest uppercase transition-all"
                    >
                        Ack & Close
                    </button>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    // --- MOTOR MATEMÁTICO (Traducción JS del Python de Claude) ---
    const MATH = {
        rastrigin: {
            f: (x, y) =>
                10 * 2 +
                (x ** 2 - 10 * Math.cos(2 * Math.PI * x)) +
                (y ** 2 - 10 * Math.cos(2 * Math.PI * y)),
            grad: (x, y) => ({
                x: 2 * x + 20 * Math.PI * Math.sin(2 * Math.PI * x),
                y: 2 * y + 20 * Math.PI * Math.sin(2 * Math.PI * y),
            }),
            limit: 5.12,
        },
        himmelblau: {
            f: (x, y) => (x ** 2 + y - 11) ** 2 + (x + y ** 2 - 7) ** 2,
            grad: (x, y) => {
                const a = x ** 2 + y - 11;
                const b = x + y ** 2 - 7;
                return { x: 4 * x * a + 2 * b, y: 2 * a + 4 * y * b };
            },
            limit: 5,
        },
        ackley: {
            f: (x, y) =>
                -20 * Math.exp(-0.2 * Math.sqrt(0.5 * (x ** 2 + y ** 2))) -
                Math.exp(
                    0.5 *
                        (Math.cos(2 * Math.PI * x) + Math.cos(2 * Math.PI * y)),
                ) +
                Math.E +
                20,
            grad: (x, y) =>
                numericalGradient(x, y, (xx, yy) => MATH.ackley.f(xx, yy)),
            limit: 5,
        },
        rosenbrock: {
            f: (x, y) => Math.pow(1 - x, 2) + 100 * Math.pow(y - x * x, 2),
            grad: (x, y) => ({
                x: -2 * (1 - x) - 400 * x * (y - x ** 2),
                y: 200 * (y - x ** 2),
            }),
            limit: 2,
        },
    };

    // Altura con la que se DIBUJA un punto. Debe coincidir con la escala de la
    // superficie que genera optimization_engine.py: Rosenbrock se guarda como
    // log(z + 1) para que sus picos no aplasten el gráfico. (El "loss" que se
    // muestra en las métricas sigue siendo el valor real de la función.)
    function displayZ(func, z) {
        return func === "rosenbrock" ? Math.log(z + 1) : z;
    }

    // Derivada numérica para funciones complejas (Ackley)
    function numericalGradient(x, y, f) {
        const h = 1e-5;
        return {
            x: (f(x + h, y) - f(x - h, y)) / (2 * h),
            y: (f(x, y + h) - f(x, y - h)) / (2 * h),
        };
    }

    // --- VARIABLES DE ESTADO ---
    let mapData = null;
    let currentFunc = "rastrigin";
    let agent = { x: 3.5, y: 2.1, vx: 0, vy: 0 };
    let isRunning = false;
    let animId = null;

    // --- DOM ---
    const UI = {
        plot: document.getElementById("plot"),
        funcSel: document.getElementById("funcSelector"),
        lr: document.getElementById("lr"),
        mom: document.getElementById("mom"),
        lrDisp: document.getElementById("lrVal"),
        momDisp: document.getElementById("momVal"),
        stats: {
            pos: document.getElementById("posVal"),
            loss: document.getElementById("lossVal"),
            vel: document.getElementById("velVal"),
        },
        loading: document.getElementById("loading"),
    };

    // --- LÓGICA DE SIMULACIÓN (PHYSICS STEP) ---
    function computePhysics() {
        const alpha = parseFloat(UI.lr.value);
        const gamma = parseFloat(UI.mom.value);
        const func = MATH[currentFunc];

        // 1. Calcular Gradiente
        const g = func.grad(agent.x, agent.y);

        // 2. Actualizar Velocidad (Momentum)
        agent.vx = gamma * agent.vx + alpha * g.x;
        agent.vy = gamma * agent.vy + alpha * g.y;

        // Clipping (Seguridad visual)
        const maxV = 2.0;
        agent.vx = Math.max(-maxV, Math.min(maxV, agent.vx));
        agent.vy = Math.max(-maxV, Math.min(maxV, agent.vy));

        // 3. Mover Agente (Gradient Descent: Restamos velocidad)
        agent.x -= agent.vx;
        agent.y -= agent.vy;

        // Límites del mapa
        const L = func.limit;
        if (Math.abs(agent.x) > L) {
            agent.x = Math.sign(agent.x) * L;
            agent.vx = 0;
        }
        if (Math.abs(agent.y) > L) {
            agent.y = Math.sign(agent.y) * L;
            agent.vy = 0;
        }

        return func.f(agent.x, agent.y);
    }

    function animationLoop() {
        if (!isRunning) return;

        // Calcular varios pasos físicos por frame gráfico (Super Speed)
        const trace = { x: [], y: [], z: [] };
        let finalZ = 0;

        for (let i = 0; i < 4; i++) {
            finalZ = computePhysics();
            trace.x.push(agent.x);
            trace.y.push(agent.y);
            trace.z.push(displayZ(currentFunc, finalZ));

            if (Math.sqrt(agent.vx ** 2 + agent.vy ** 2) < 1e-5)
                isRunning = false;
        }

        // Dibujar línea (Traza 1)
        // @ts-ignore
        Plotly.extendTraces(
            UI.plot,
            {
                x: [trace.x],
                y: [trace.y],
                z: [trace.z.map((z) => z + 0.1)],
            },
            [1],
        );

        // Mover Bola (Traza 2)
        // @ts-ignore
        Plotly.restyle(
            UI.plot,
            {
                x: [[agent.x]],
                y: [[agent.y]],
                z: [[displayZ(currentFunc, finalZ) + 0.1]],
            },
            [2],
        );

        updateStats(finalZ);
        if (isRunning) requestAnimationFrame(animationLoop);
    }

    function updateStats(loss) {
        UI.stats.pos.innerText = `${agent.x.toFixed(2)}, ${agent.y.toFixed(2)}`;
        UI.stats.loss.innerText = loss.toFixed(4);
        UI.stats.vel.innerText = Math.sqrt(
            agent.vx ** 2 + agent.vy ** 2,
        ).toFixed(3);
    }

    // --- RENDER 3D ---
    function renderMap() {
        const surface = mapData[currentFunc];
        const agentZ = displayZ(currentFunc, MATH[currentFunc].f(agent.x, agent.y));

        const data = [
            {
                // 0: Superficie
                type: "surface",
                x: surface.x,
                y: surface.y,
                z: surface.z,
                colorscale: "Viridis",
                showscale: false,
                opacity: 0.9,
                contours: {
                    z: {
                        show: true,
                        usecolormap: true,
                        highlightcolor: "#00e5ff",
                        project: { z: true },
                    },
                },
            },
            {
                // 1: Trayectoria
                type: "scatter3d",
                mode: "lines",
                x: [agent.x],
                y: [agent.y],
                z: [agentZ],
                line: { color: "#06ffa5", width: 4 },
                name: "Path",
            },
            {
                // 2: Agente
                type: "scatter3d",
                mode: "markers",
                x: [agent.x],
                y: [agent.y],
                z: [agentZ],
                marker: { size: 5, color: "#ff006e", symbol: "diamond" },
                name: "Agent",
            },
        ];

        const layout = {
            paper_bgcolor: "#000",
            plot_bgcolor: "#000",
            margin: { t: 0, b: 0, l: 0, r: 0 },
            scene: {
                xaxis: { visible: false },
                yaxis: { visible: false },
                zaxis: { visible: false },
                camera: { eye: { x: 1.4, y: 1.4, z: 1.2 } },
                aspectmode: "cube",
            },
            showlegend: false,
        };

        // @ts-ignore
        Plotly.newPlot(UI.plot, data, layout, {
            responsive: true,
            displayModeBar: false,
        });
    }

    // --- START ---
    async function init() {
        try {
            const res = await fetch("/optimization_data.json");
            mapData = await res.json();
            UI.loading.style.display = "none";
            renderMap();

            // Listeners
            UI.funcSel.addEventListener("change", (e) => {
                // @ts-ignore
                currentFunc = e.target.value;
                randomize();
                renderMap();
            });

            UI.lr.addEventListener(
                "input",
                (e) => (UI.lrDisp.innerText = e.target.value),
            );
            UI.mom.addEventListener(
                "input",
                (e) => (UI.momDisp.innerText = e.target.value),
            );

            document
                .getElementById("randomize")
                .addEventListener("click", () => {
                    randomize();
                    // Reiniciar trayectoria (traza 1) y agente (traza 2) en su lugar.
                    // Antes se borraba y re-agregaba la traza 1, lo que la movía al
                    // final y hacía que "Run" dibujara rombos en vez de la línea.
                    const z = displayZ(currentFunc, MATH[currentFunc].f(agent.x, agent.y));
                    // @ts-ignore
                    Plotly.restyle(
                        UI.plot,
                        { x: [[agent.x]], y: [[agent.y]], z: [[z]] },
                        [1, 2],
                    );
                });

            document.getElementById("runBtn").addEventListener("click", () => {
                if (!isRunning) {
                    isRunning = true;
                    animationLoop();
                } else {
                    isRunning = false;
                }
            });

            // --- MODAL LOGIC ---
            const modal = document.getElementById("infoModal");
            const openBtn = document.getElementById("infoBtn");
            const closeBtn = document.getElementById("closeModal");
            const ackBtn = document.getElementById("acknowledgeBtn");

            function toggleModal(show) {
                if (show) {
                    modal.classList.remove("hidden");
                    // Pequeña animación de entrada
                    // @ts-ignore
                    modal.firstElementChild.style.opacity = "0";
                    // @ts-ignore
                    modal.firstElementChild.style.transform = "scale(0.95)";
                    setTimeout(() => {
                        // @ts-ignore
                        modal.firstElementChild.style.transition =
                            "all 0.2s ease-out";
                        // @ts-ignore
                        modal.firstElementChild.style.opacity = "1";
                        // @ts-ignore
                        modal.firstElementChild.style.transform = "scale(1)";
                    }, 10);
                } else {
                    modal.classList.add("hidden");
                }
            }

            openBtn.addEventListener("click", () => toggleModal(true));
            closeBtn.addEventListener("click", () => toggleModal(false));
            ackBtn.addEventListener("click", () => toggleModal(false));

            // Cerrar con tecla ESC
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") toggleModal(false);
            });
        } catch (err) {
            console.error(err);
            UI.loading.innerHTML = "DATA ERROR - PLEASE RUN PYTHON SCRIPT";
        }
    }

    function randomize() {
        const L = MATH[currentFunc].limit;
        agent.x = Math.random() * L * 1.5 - L * 0.75;
        agent.y = Math.random() * L * 1.5 - L * 0.75;
        agent.vx = 0;
        agent.vy = 0;
    }

    init();
</script>
